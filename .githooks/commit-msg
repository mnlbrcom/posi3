#!/bin/sh
# Enforce CLAUDE.md §7: a change under src/ is an implementation request and
# must carry a docs/FEATURES.md entry in the same commit. This is the one rule
# that has repeatedly slipped (menu icons, the whole ui-work branch) because
# nothing checked it — so now something does.
#
# Escape hatch: put [skip-features] anywhere in the commit message when a src/
# change genuinely is not an implementation request (pure refactor, formatting,
# a config tweak, a follow-up fix already covered by an existing entry).

msg_file="$1"

# A merge commit's diff is the union of the branch's work; the FEATURES entries
# live in the branch commits, not the merge. Don't second-guess merges.
if [ -f "$(git rev-parse --git-dir)/MERGE_HEAD" ]; then
  exit 0
fi

if grep -qF '[skip-features]' "$msg_file"; then
  exit 0
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
touches_src=$(printf '%s\n' "$staged" | grep -E '^src/')
touches_features=$(printf '%s\n' "$staged" | grep -E '^docs/FEATURES\.md$')

if [ -n "$touches_src" ] && [ -z "$touches_features" ]; then
  echo "✗ src/ changed but docs/FEATURES.md was not (CLAUDE.md §7)." >&2
  echo "  Add a dated entry for what this change does, or — if it genuinely is" >&2
  echo "  not an implementation request — put [skip-features] in the message." >&2
  exit 1
fi

exit 0
