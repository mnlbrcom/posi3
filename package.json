{
  "name": "posi3",
  "productName": "posi3",
  "version": "3.0.0",
  "description": "Bridges POSITAL IXARC rotary encoders to disguise (d3) media servers, with a web interface.",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/desktop/main.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "electron .",
    "dev": "electron . --dev",
    "headless": "node bin/posi3.js --headless",
    "test": "npm run lint --silent && node --test --test-concurrency=1 \"test/*.test.js\"",
    "mock": "node tools/mock-encoder.js",
    "sink": "node tools/udp-sink.js",
    "bench": "node tools/latency-bench.js",
    "harness": "node tools/link-harness.js",
    "icon": "node tools/make-app-icon.js",
    "dist:mac": "npm run stamp && npm run icon && electron-builder --mac --arm64 --x64",
    "dist:win": "npm run stamp && npm run icon && electron-builder --win --x64",
    "uicheck": "node tools/uicheck.js",
    "tray-icon": "node tools/make-tray-icon.js",
    "shaft": "node tools/shaft-check.js",
    "desktopcheck": "node tools/desktopcheck.js",
    "lint": "eslint .",
    "zoomcheck": "node tools/zoomcheck.js",
    "stamp": "node tools/stamp-revision.js"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "eslint": "9.39.5"
  },
  "allowScripts": {
    "electron@43.2.0": true
  }
}
