# Oracle's JRE 7 installer, 29 MB of the 38 MB reference archive. Not ours to
# redistribute, permanent once in git history, and made obsolete by the native
# encoder config panel. It stays in Dropbox with the rest of the venue material.
input/**/jre-*.exe

node_modules/
release/
# build/ holds the generated app icons. They ARE committed: the previous build
# referenced generated images that were never tracked, so a clean checkout
# could not package. Regenerate with `npm run icon`.
*.log
.DS_Store

# Written by `npm run stamp` at package time: it names the commit it was
# generated from, so a committed copy would always be one behind.
revision.json

# pr-agent local review output
review.md
description.md

# pr-agent user config (model/instructions); machine-specific
.pr_agent.toml
